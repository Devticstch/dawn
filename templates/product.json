{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "rating": {
          "type": "rating"
        },
        "title": {
          "type": "title"
        },
        "byline": {
          "type": "byline",
          "settings": {
            "prefix": ""
          }
        },
        "price": {
          "type": "price"
        },
        "card_2": {
          "type": "card_break"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {}
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Buy it with",
            "enable_quick_add": true
          }
        }
      },
      "block_order": [
        "byline",
        "title",
        "price",
        "rating",
        "card_2",
        "variant_picker",
        "quantity_selector",
        "inventory",
        "buy_buttons",
        "complementary"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-2",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 36,
        "info_style": "panel",
        "show_sticky_bar": true
      }
    },
    "about": {
      "type": "product-about",
      "blocks": {
        "spec_brand": {
          "type": "spec",
          "settings": {
            "label": "Brand",
            "source": "vendor"
          }
        },
        "spec_type": {
          "type": "spec",
          "settings": {
            "label": "Type",
            "source": "type"
          }
        },
        "spec_sku": {
          "type": "spec",
          "settings": {
            "label": "SKU",
            "source": "sku"
          }
        },
        "spec_weight": {
          "type": "spec",
          "settings": {
            "label": "Weight",
            "source": "weight"
          }
        }
      },
      "block_order": [
        "spec_brand",
        "spec_type",
        "spec_sku",
        "spec_weight"
      ],
      "settings": {}
    },
    "reviews": {
      "type": "product-reviews",
      "settings": {}
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "about",
    "reviews",
    "disclosures",
    "related-products"
  ]
}
