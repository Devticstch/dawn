{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign scroller_id = 'Scroller-' | append: section.id
-%}

<div
  class="best-sellers cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --bs-card-bg: {{ section.settings.card_background }}; --bs-accent: {{ section.settings.accent_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
>
  <div class="cs-container">
    <div class="cs-header-row">
      <h2 class="best-sellers__heading">{{ section.settings.heading | escape }}</h2>
      <div class="cs-scroller__nav cs-scroller__nav--desktop">
        <button
          type="button"
          class="best-sellers__arrow"
          data-scroller-prev="{{ scroller_id }}"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          {% render 'cs-icon', icon: 'chevron-left' %}
        </button>
        <button
          type="button"
          class="best-sellers__arrow"
          data-scroller-next="{{ scroller_id }}"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          {% render 'cs-icon', icon: 'chevron-right' %}
        </button>
      </div>
    </div>

    <cs-scroller id="{{ scroller_id }}" class="cs-scroller best-sellers__scroller">
      <ul class="cs-scroller__track" role="list">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <li class="best-sellers__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_secondary_image: true,
                skip_styles: true,
                section_id: section.id
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="best-sellers__item">
              {% render 'card-product', show_vendor: false, placeholder_image: 'product-apparel-1' %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </cs-scroller>

    {%- if section.blocks.size > 0 -%}
      <div class="best-sellers__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign reveal = ''
            if settings.animations_reveal_on_scroll
              assign reveal = ' scroll-trigger animate--slide-in'
            endif
          -%}
          {%- case block.type -%}
            {%- when 'image_tile' -%}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="best-sellers__tile best-sellers__tile--tall cs-media cs-link-reset{{ reveal }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 800, 1100, 1400, 1600',
                      sizes: '(min-width: 990px) 50vw, 100vw'
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                <span class="best-sellers__tile-body">
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="best-sellers__eyebrow">{{ block.settings.eyebrow | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <span class="best-sellers__tile-heading">{{ block.settings.heading | escape }}</span>
                  {%- endif -%}
                </span>
              </a>

            {%- when 'features' -%}
              <div class="best-sellers__features{{ reveal }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="best-sellers__features-heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                <ul class="best-sellers__feature-list" role="list">
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign icon_key = 'icon_' | append: i
                      assign text_key = 'text_' | append: i
                    -%}
                    {%- if block.settings[text_key] != blank -%}
                      <li class="best-sellers__feature">
                        <span class="best-sellers__feature-icon">
                          {%- render 'cs-icon', icon: block.settings[icon_key] -%}
                        </span>
                        <span class="best-sellers__feature-text">
                          {{- block.settings[text_key] | escape | newline_to_br -}}
                        </span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'banner' -%}
              <div class="best-sellers__tile best-sellers__banner cs-media{{ reveal }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 800, 1100, 1400',
                      sizes: '(min-width: 990px) 50vw, 100vw'
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.link != blank %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="best-sellers__banner-button"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section section-best-sellers",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F2F4F7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2457F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "image_tile",
      "name": "Tall image tile",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1200 × 1240 px" },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Why our cases" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Built to be dropped" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "features",
      "name": "Feature list",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Protection you can feel" },
        {
          "type": "select",
          "id": "icon_1",
          "label": "Icon 1",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "warranty", "label": "Badge" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "secure", "label": "Secure payment" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "textarea", "id": "text_1", "label": "Text 1", "default": "Drop tested\nto 3 meters" },
        {
          "type": "select",
          "id": "icon_2",
          "label": "Icon 2",
          "default": "sparkle",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "warranty", "label": "Badge" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "secure", "label": "Secure payment" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "textarea", "id": "text_2", "label": "Text 2", "default": "Anti-yellowing\nclear finish" },
        {
          "type": "select",
          "id": "icon_3",
          "label": "Icon 3",
          "default": "warranty",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "warranty", "label": "Badge" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "secure", "label": "Secure payment" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "textarea", "id": "text_3", "label": "Text 3", "default": "24-month\nwarranty" }
      ]
    },
    {
      "type": "banner",
      "name": "Image with button",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1200 × 560 px" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best sellers",
      "blocks": [{ "type": "image_tile" }, { "type": "features" }, { "type": "banner" }]
    }
  ]
}
{% endschema %}
