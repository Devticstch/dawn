{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .best-sellers__heading,
  #shopify-section-{{ section.id }} .bs-card__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #shopify-section-{{ section.id }} .best-sellers__heading {
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
-%}

<div
  class="best-sellers cs-section"
  style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px; --bs-card-bg: {{ section.settings.card_background }}; --bs-badge: {{ section.settings.badge_color }}; --bs-accent: {{ section.settings.accent_color }};"
>
  <div class="cs-container">
    {%- if section.settings.title != blank -%}
      <h2 class="best-sellers__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <best-sellers-slider class="best-sellers__slider">
      <ul class="best-sellers__track" role="list">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="best-sellers__slide{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}" data-cascade>
            {%- render 'bs-card', product: product, index: forloop.index0, show_swatches: section.settings.show_swatches, action: 'cart' -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="best-sellers__progress" aria-hidden="true" hidden>
        <span class="best-sellers__progress-bar"></span>
      </div>
    </best-sellers-slider>
  </div>
</div>

{% javascript %}
  // Moves the progress bar with the horizontal scroll; hidden when every card fits.
  class BestSellersSlider extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.best-sellers__track');
      this.progress = this.querySelector('.best-sellers__progress');
      this.bar = this.querySelector('.best-sellers__progress-bar');
      this.update = this.update.bind(this);
      this.track.addEventListener('scroll', this.update, { passive: true });
      this.observer = new ResizeObserver(this.update);
      this.observer.observe(this.track);
    }

    disconnectedCallback() {
      this.track.removeEventListener('scroll', this.update);
      this.observer.disconnect();
    }

    update() {
      const { scrollLeft, scrollWidth, clientWidth } = this.track;
      const overflow = scrollWidth - clientWidth;
      this.progress.hidden = overflow <= 1;
      if (overflow <= 1) return;
      const share = clientWidth / scrollWidth;
      this.bar.style.width = `${share * 100}%`;
      this.bar.style.transform = `translateX(${(scrollLeft / overflow) * ((1 - share) / share) * 100}%)`;
    }
  }

  customElements.define('best-sellers-slider', BestSellersSlider);
{% endjavascript %}

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section section-best-sellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true, "info": "Uses the product option named Color or Colour" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading and product title font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F6F6F6" },
    { "type": "color", "id": "badge_color", "label": "Sale badge color", "default": "#DA1E28" },
    { "type": "color", "id": "accent_color", "label": "Buttons and progress bar color", "default": "#8825E4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
