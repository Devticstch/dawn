{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .best-sellers__heading,
  #shopify-section-{{ section.id }} .bs-card__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #shopify-section-{{ section.id }} .best-sellers__heading {
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
-%}

<div
  class="best-sellers cs-section"
  style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px; --bs-card-bg: {{ section.settings.card_background }}; --bs-badge: {{ section.settings.badge_color }}; --bs-accent: {{ section.settings.accent_color }};"
>
  <div class="cs-container">
    {%- if section.settings.title != blank -%}
      <h2 class="best-sellers__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <best-sellers-slider class="best-sellers__slider">
      <ul class="best-sellers__track" id="BestSellersTrack-{{ section.id }}" role="list">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="best-sellers__slide{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}" data-cascade>
            {%- render 'bs-card', product: product, index: forloop.index0, show_swatches: section.settings.show_swatches, action: 'cart' -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="best-sellers__nav" data-nav hidden>
        <button type="button" class="best-sellers__arrow" data-step="-1" aria-controls="BestSellersTrack-{{ section.id }}" aria-label="{{ 'general.slider.previous_slide' | t | escape }}">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5"/></svg>
        </button>
        <div class="best-sellers__progress" aria-hidden="true">
          <span class="best-sellers__progress-bar"></span>
        </div>
        <button type="button" class="best-sellers__arrow" data-step="1" aria-controls="BestSellersTrack-{{ section.id }}" aria-label="{{ 'general.slider.next_slide' | t | escape }}">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5"/></svg>
        </button>
      </div>
    </best-sellers-slider>
  </div>
</div>

{% javascript %}
  // Horizontal product row: arrows move one card, the progress bar follows the scroll, and a vertical wheel turn over
  // the cards moves one card at a time. At either end the wheel scrolls the page as usual; the controls hide when
  // every card fits.
  class BestSellersSlider extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.best-sellers__track');
      this.nav = this.querySelector('[data-nav]');
      this.bar = this.querySelector('.best-sellers__progress-bar');
      this.arrows = this.querySelectorAll('[data-step]');
      this.update = this.update.bind(this);
      this.onWheel = this.onWheel.bind(this);
      this.track.addEventListener('scroll', this.update, { passive: true });
      this.track.addEventListener('wheel', this.onWheel, { passive: false });
      this.arrows.forEach((arrow) => arrow.addEventListener('click', () => this.step(Number(arrow.dataset.step))));
      this.observer = new ResizeObserver(this.update);
      this.observer.observe(this.track);
    }

    disconnectedCallback() {
      this.track.removeEventListener('scroll', this.update);
      this.track.removeEventListener('wheel', this.onWheel);
      this.observer.disconnect();
    }

    // One card (with its gap) per step; scroll snapping lines the next card up
    step(direction) {
      const slide = this.track.firstElementChild;
      if (!slide) return;
      const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.track.scrollBy({ left: direction * (slide.getBoundingClientRect().width + gap), behavior: smooth ? 'smooth' : 'auto' });
    }

    canScroll(direction) {
      const { scrollLeft, scrollWidth, clientWidth } = this.track;
      return direction < 0 ? scrollLeft > 1 : scrollLeft < scrollWidth - clientWidth - 1;
    }

    // Vertical wheel over the cards: one card per turn while the row can still move that way; sideways
    // (trackpad or shift) scrolling stays native, and at the ends the page scrolls normally
    onWheel(event) {
      if (event.ctrlKey || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      const direction = Math.sign(event.deltaY);
      if (!direction || !this.canScroll(direction)) return;
      event.preventDefault();
      if (this.wheelLocked) return;
      this.wheelLocked = true;
      setTimeout(() => (this.wheelLocked = false), 450);
      this.step(direction);
    }

    update() {
      const { scrollLeft, scrollWidth, clientWidth } = this.track;
      const overflow = scrollWidth - clientWidth;
      this.nav.hidden = overflow <= 1;
      if (overflow <= 1) return;
      this.arrows.forEach((arrow) => (arrow.disabled = !this.canScroll(Number(arrow.dataset.step))));
      const share = clientWidth / scrollWidth;
      this.bar.style.width = `${share * 100}%`;
      this.bar.style.transform = `translateX(${(scrollLeft / overflow) * ((1 - share) / share) * 100}%)`;
    }
  }

  customElements.define('best-sellers-slider', BestSellersSlider);
{% endjavascript %}

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section section-best-sellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true, "info": "Uses the product option named Color or Colour" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading and product title font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F6F6F6" },
    { "type": "color", "id": "badge_color", "label": "Sale badge color", "default": "#DA1E28" },
    { "type": "color", "id": "accent_color", "label": "Buttons and progress bar color", "default": "#8825E4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 }
  ],
  "presets": [{ "name": "Best sellers" }]
}
{% endschema %}
