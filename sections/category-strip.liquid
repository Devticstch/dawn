<div
  class="category-strip cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="cs-container category-panels">
    {%- assign category_groups = 'phone_case,accessories' | split: ',' -%}
    {%- for group in category_groups -%}
      {%- liquid
        case group
          when 'phone_case'
            assign panel_heading = section.settings.phone_case_heading
            assign panel_image = section.settings.phone_case_image
            assign panel_link = section.settings.phone_case_link
          when 'accessories'
            assign panel_heading = section.settings.accessories_heading
            assign panel_image = section.settings.accessories_image
            assign panel_link = section.settings.accessories_link
        endcase
      -%}
      <section class="category-panel" aria-labelledby="CategoryPanelHeading-{{ section.id }}-{{ group }}">
        <div class="category-panel__feature">
          <div class="category-panel__intro">
            {%- if panel_heading != blank -%}
              <h2 class="category-panel__heading" id="CategoryPanelHeading-{{ section.id }}-{{ group }}">
                {{ panel_heading | escape }}
              </h2>
            {%- endif -%}
            {%- if panel_link != blank -%}
              <a class="category-panel__button" href="{{ panel_link }}">Shop all</a>
            {%- endif -%}
          </div>
          {%- if panel_image != blank -%}
            <div class="category-panel__feature-image">
              {{
                panel_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '450, 650, 900, 1200', sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 35vw, 65vw', alt: panel_heading
              }}
            </div>
          {%- endif -%}
        </div>
        <ul class="category-panel__categories" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.group == group -%}
              {%- liquid
                assign collection = block.settings.collection
                assign label = block.settings.label | default: collection.title
                assign image = block.settings.image | default: collection.featured_image
                assign link = block.settings.link | default: collection.url
              -%}
              <li class="category-panel__category" {{ block.shopify_attributes }}>
                {%- if link != blank -%}
                  <a class="category-panel__category-link" href="{{ link }}">
                {%- else -%}
                  <div class="category-panel__category-link">
                {%- endif -%}
                  <span class="category-panel__category-image">
                    {%- if image != blank -%}
                      {{
                        image
                        | image_url: width: 240
                        | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '(min-width: 750px) 5vw, 14vw', alt: label
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </span>
                  <span class="category-panel__category-label">{{ label | escape }}</span>
                {%- if link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </section>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category strip",
  "tag": "section",
  "class": "section section-category-strip",
  "max_blocks": 30,
  "settings": [
    {
      "type": "text",
      "id": "phone_case_heading",
      "label": "Phone case panel heading",
      "default": "Phone Case"
    },
    {
      "type": "image_picker",
      "id": "phone_case_image",
      "label": "Phone case panel image"
    },
    {
      "type": "url",
      "id": "phone_case_link",
      "label": "Phone case panel link"
    },
    {
      "type": "text",
      "id": "accessories_heading",
      "label": "Accessories panel heading",
      "default": "Accessories"
    },
    {
      "type": "image_picker",
      "id": "accessories_image",
      "label": "Accessories panel image"
    },
    {
      "type": "url",
      "id": "accessories_link",
      "label": "Accessories panel link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Fills in the image, label and link automatically"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG works best. Overrides the collection image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "group",
          "label": "Panel",
          "options": [
            { "value": "phone_case", "label": "Phone Case" },
            { "value": "accessories", "label": "Accessories" }
          ],
          "default": "phone_case"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Overrides the collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category strip",
      "blocks": [
        { "type": "category", "settings": { "label": "Phone Cases" } },
        { "type": "category", "settings": { "label": "Bundle Sets" } },
        { "type": "category", "settings": { "label": "Phone Straps" } },
        { "type": "category", "settings": { "label": "MagSafe" } },
        { "type": "category", "settings": { "label": "Charms" } },
        { "type": "category", "settings": { "label": "Travel" } }
      ]
    }
  ]
}
{% endschema %}
