{%- comment -%}
  Sale popup for the home page: a native modal <dialog> that opens a few seconds after landing. Once the visitor closes
  it (X, Esc, backdrop) or follows the button, it stays closed for the rest of the browsing session (sessionStorage).
  In the theme editor it opens only while the section is selected.
{%- endcomment -%}
<sale-popup data-delay="{{ section.settings.delay }}" data-key="sale-popup-{{ section.id }}">
  <dialog class="sale-popup" tabindex="-1" aria-labelledby="SalePopupHeading-{{ section.id }}">
    <div class="sale-popup__inner">
      <button type="button" class="sale-popup__close" aria-label="{{ 'accessibility.close' | t }}">
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
      </button>
      {%- if section.settings.heading != blank -%}
        <h2 id="SalePopupHeading-{{ section.id }}" class="sale-popup__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="sale-popup__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text_2 != blank -%}
        <p class="sale-popup__text-2">{{ section.settings.text_2 | escape }}</p>
      {%- endif -%}
      {%- if section.settings.small_text != blank -%}
        <p class="sale-popup__small">{{ section.settings.small_text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button sale-popup__button">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </dialog>
</sale-popup>

{% stylesheet %}
  /* Compact dark card like the store's other brand surfaces (charcoal, soft purple glow, purple-cyan line on top).
     The heading takes the menu's 11.11 SALE badge gradient; contrast on #1e1e1e: #ff512f 5.4:1, #f09819 8.2:1 */
  .sale-popup {
    width: min(42rem, 100% - 3.2rem);
    max-height: calc(100% - 3.2rem);
    padding: 0;
    border: 0;
    border-radius: var(--modal-corner-radius, 2rem);
    background: #1e1e1e;
    color: #fff;
    overflow: auto;
    opacity: 0;
    transform: translateY(1.6rem);
    transition: opacity 0.25s ease, transform 0.25s ease, overlay 0.25s allow-discrete, display 0.25s allow-discrete;
  }

  .sale-popup[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .sale-popup[open] {
      opacity: 0;
      transform: translateY(1.6rem);
    }
  }

  /* Focus starts on the dialog box itself (see open()), so no ring shows until the visitor tabs to a control */
  .sale-popup:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .sale-popup::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .sale-popup__inner {
    position: relative;
    padding: 4.8rem 3.2rem 3.2rem;
    text-align: center;
    background:
      var(--t2c-gradient, linear-gradient(90deg, #8825e4 0%, #00ffff 100%)) top / 100% 0.4rem no-repeat,
      radial-gradient(120% 70% at 50% 0%, rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.35) 0%, transparent 70%);
  }

  .sale-popup__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    border: 0.1rem solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .sale-popup__close:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .sale-popup__close:focus-visible {
    outline: 0.2rem solid var(--t2c-cyan, #00ffff);
    outline-offset: 0.2rem;
  }

  .sale-popup__close .svg-wrapper {
    width: 1.4rem;
    height: 1.4rem;
  }

  .sale-popup__heading {
    margin: 0;
    font-size: 4.4rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    color: #ff512f;
    background: linear-gradient(90deg, #ff512f, #f09819);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sale-popup__text {
    margin: 1.6rem 0 0;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.4;
    color: #fff;
  }

  .sale-popup__text-2 {
    margin: 0.8rem 0 0;
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--t2c-cyan, #00ffff);
  }

  .sale-popup__small {
    margin: 1.6rem 0 0;
    font-size: 1.3rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }

  .sale-popup__button.button {
    width: 100%;
    margin-top: 2.4rem;
  }

  @media screen and (max-width: 749px) {
    .sale-popup__inner {
      padding: 4.8rem 2.4rem 2.4rem;
    }

    .sale-popup__heading {
      font-size: 3.6rem;
    }

    .sale-popup__text {
      font-size: 1.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sale-popup,
    .sale-popup[open] {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('sale-popup')) {
    customElements.define(
      'sale-popup',
      class SalePopup extends HTMLElement {
        connectedCallback() {
          this.dialog = this.querySelector('dialog');
          this.querySelector('.sale-popup__close').addEventListener('click', () => this.dialog.close());
          // A click on the dialog itself (not its content) is a click on the backdrop
          this.dialog.addEventListener('click', (event) => {
            if (event.target === this.dialog) this.dialog.close();
          });
          this.dialog.addEventListener('close', () => this.remember());
          this.querySelector('.sale-popup__button')?.addEventListener('click', () => this.remember());

          if (window.Shopify && Shopify.designMode) {
            document.addEventListener('shopify:section:select', (event) => {
              if (this.closest('.shopify-section')?.id === `shopify-section-${event.detail.sectionId}`) this.open();
            });
            document.addEventListener('shopify:section:deselect', () => this.dialog.open && this.dialog.close());
            return;
          }

          if (!this.seen()) setTimeout(() => this.openWhenFree(), Number(this.dataset.delay) * 1000);
        }

        seen() {
          try {
            return sessionStorage.getItem(this.dataset.key) === '1';
          } catch (error) {
            // Storage blocked (privacy settings): treat as not seen, so the popup shows once per page load
            return false;
          }
        }

        remember() {
          try {
            sessionStorage.setItem(this.dataset.key, '1');
          } catch (error) {
            // Storage blocked (privacy settings): nothing to remember beyond this page load
          }
        }

        // Waits while a drawer or another modal is open (Dawn locks the page scroll with an overflow-hidden class)
        openWhenFree() {
          if (/\boverflow-hidden/.test(document.body.className) || document.querySelector('dialog[open]')) {
            setTimeout(() => this.openWhenFree(), 2000);
            return;
          }
          this.open();
        }

        open() {
          if (this.dialog.open) return;
          this.dialog.showModal();
          this.dialog.focus();
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Sale popup",
  "tag": "div",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "11.11 SALE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Main text",
      "default": "Up to 50% OFF on stylish phone cases"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Second line",
      "default": "Plus EXTRA 5% OFF on online payments"
    },
    {
      "type": "text",
      "id": "small_text",
      "label": "Small text",
      "default": "Sale runs from 05/11 to 25/11."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Delay before it opens",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Sale popup"
    }
  ]
}
{% endschema %}
