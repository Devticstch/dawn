{%- comment -%}
  Sale popup for the home page: a native modal <dialog> that opens a few seconds after landing. Once the visitor closes
  it (X, Esc, backdrop) or follows the button, it stays closed for the rest of the browsing session (sessionStorage).
  In the theme editor it opens only while the section is selected.
{%- endcomment -%}
<sale-popup data-delay="{{ section.settings.delay }}" data-key="sale-popup-{{ section.id }}">
  <dialog class="sale-popup" tabindex="-1" aria-labelledby="SalePopupHeading-{{ section.id }}">
    <canvas class="sale-popup__confetti" aria-hidden="true"></canvas>
    <div class="sale-popup__inner">
      <button type="button" class="sale-popup__close" aria-label="{{ 'accessibility.close' | t }}">
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
      </button>
      {%- if section.settings.heading != blank -%}
        <h2 id="SalePopupHeading-{{ section.id }}" class="sale-popup__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="sale-popup__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text_2 != blank -%}
        <p class="sale-popup__text-2">{{ section.settings.text_2 | escape }}</p>
      {%- endif -%}
      {%- if section.settings.small_text != blank -%}
        <p class="sale-popup__small">{{ section.settings.small_text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button sale-popup__button">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </dialog>
</sale-popup>

{% stylesheet %}
  /* Light card with the brand accents: purple-cyan line on top, faint purple and cyan glows in opposite corners.
     Cyan stays decorative (unreadable on white); text uses charcoal and purple. The heading runs from purple to the
     buttons' 73/27 purple-cyan blend (#6360eb, 4.8:1 on white) */
  .sale-popup {
    width: min(44rem, 100% - 3.2rem);
    max-height: calc(100% - 3.2rem);
    padding: 0;
    border: 0.1rem solid rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.12);
    border-radius: var(--modal-corner-radius, 2rem);
    background: #fff;
    color: #1e1e1e;
    box-shadow: 0 2.4rem 6.4rem rgba(30, 30, 30, 0.18);
    overflow: auto;
    opacity: 0;
    transform: translateY(1.6rem);
    transition: opacity 0.25s ease, transform 0.25s ease, overlay 0.25s allow-discrete, display 0.25s allow-discrete;
  }

  .sale-popup[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .sale-popup[open] {
      opacity: 0;
      transform: translateY(1.6rem);
    }
  }

  /* Focus starts on the dialog box itself (see open()), so no ring shows until the visitor tabs to a control */
  .sale-popup:focus-visible {
    outline: none;
    box-shadow: 0 2.4rem 6.4rem rgba(30, 30, 30, 0.18);
  }

  .sale-popup::backdrop {
    background: rgba(30, 30, 30, 0.5);
    -webkit-backdrop-filter: blur(0.3rem);
    backdrop-filter: blur(0.3rem);
  }

  .sale-popup__inner {
    position: relative;
    padding: 5.2rem 3.6rem 3.6rem;
    text-align: center;
    background:
      var(--t2c-gradient, linear-gradient(90deg, #8825e4 0%, #00ffff 100%)) top / 100% 0.4rem no-repeat,
      radial-gradient(70% 55% at 0% 0%, rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.1) 0%, transparent 100%),
      radial-gradient(70% 55% at 100% 100%, rgba(var(--t2c-cyan-rgb, 0, 255, 255), 0.14) 0%, transparent 100%),
      #fff;
  }

  /* Confetti layer: covers the viewport (fixed; the open dialog has no transform, so the viewport is its containing
     block) and sits under the card's opaque content (z-index -1 inside the dialog's top-layer stacking context), so
     particles burst out from behind the card over the dimmed page. It never takes clicks */
  .sale-popup__confetti {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  .sale-popup__close {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #f6f6f6;
    color: #1e1e1e;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .sale-popup__close:hover {
    background: rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.1);
    color: var(--t2c-purple, #8825e4);
  }

  .sale-popup__close:focus-visible {
    outline: 0.2rem solid var(--t2c-purple, #8825e4);
    outline-offset: 0.2rem;
    box-shadow: none;
  }

  .sale-popup__close .svg-wrapper {
    width: 1.4rem;
    height: 1.4rem;
  }

  .sale-popup__heading {
    margin: 0;
    font-size: 5.2rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--t2c-purple, #8825e4);
    background: linear-gradient(90deg, #8825e4 0%, #6360eb 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sale-popup__text {
    margin: 1.6rem 0 0;
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.4;
    color: #1e1e1e;
  }

  .sale-popup__text-2 {
    display: inline-block;
    margin: 1.2rem 0 0;
    padding: 0.6rem 1.6rem;
    border-radius: 10rem;
    background: rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.08);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--t2c-purple, #8825e4);
  }

  .sale-popup__small {
    margin: 1.6rem 0 0;
    font-size: 1.3rem;
    line-height: 1.5;
    color: rgba(30, 30, 30, 0.65);
  }

  .sale-popup__button.button {
    width: 100%;
    min-height: 5.2rem;
    margin-top: 2.4rem;
    font-size: 1.6rem;
    box-shadow: 0 0.8rem 2.4rem rgba(var(--t2c-purple-rgb, 136, 37, 228), 0.28);
  }

  @media screen and (max-width: 749px) {
    .sale-popup__inner {
      padding: 4.8rem 2.4rem 2.4rem;
    }

    .sale-popup__heading {
      font-size: 4.2rem;
    }

    .sale-popup__text {
      font-size: 1.8rem;
    }

    .sale-popup__text-2 {
      font-size: 1.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sale-popup,
    .sale-popup[open] {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('sale-popup')) {
    customElements.define(
      'sale-popup',
      class SalePopup extends HTMLElement {
        connectedCallback() {
          this.dialog = this.querySelector('dialog');
          this.querySelector('.sale-popup__close').addEventListener('click', () => this.dialog.close());
          // A click on the dialog itself (not its content) is a click on the backdrop
          this.dialog.addEventListener('click', (event) => {
            if (event.target === this.dialog) this.dialog.close();
          });
          this.dialog.addEventListener('close', () => {
            this.remember();
            this.stopConfetti();
          });
          this.querySelector('.sale-popup__button')?.addEventListener('click', () => this.remember());

          if (window.Shopify && Shopify.designMode) {
            document.addEventListener('shopify:section:select', (event) => {
              if (this.closest('.shopify-section')?.id === `shopify-section-${event.detail.sectionId}`) this.open();
            });
            document.addEventListener('shopify:section:deselect', () => this.dialog.open && this.dialog.close());
            return;
          }

          if (!this.seen()) setTimeout(() => this.openWhenFree(), Number(this.dataset.delay) * 1000);
        }

        seen() {
          try {
            return sessionStorage.getItem(this.dataset.key) === '1';
          } catch (error) {
            // Storage blocked (privacy settings): treat as not seen, so the popup shows once per page load
            return false;
          }
        }

        remember() {
          try {
            sessionStorage.setItem(this.dataset.key, '1');
          } catch (error) {
            // Storage blocked (privacy settings): nothing to remember beyond this page load
          }
        }

        // Waits while a drawer or another modal is open (Dawn locks the page scroll with an overflow-hidden class)
        openWhenFree() {
          if (/\boverflow-hidden/.test(document.body.className) || document.querySelector('dialog[open]')) {
            setTimeout(() => this.openWhenFree(), 2000);
            return;
          }
          this.open();
        }

        open() {
          if (this.dialog.open) return;
          this.dialog.showModal();
          this.dialog.focus();
          // After the 0.25s rise: while the dialog is still transformed it would clip the fixed canvas to the card
          setTimeout(() => this.confetti(), 250);
        }

        // One burst of ~100 particles (60 on phones) from behind the card, then drift down; about 4s, then stops
        confetti() {
          if (!this.dialog.open || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const canvas = this.querySelector('.sale-popup__confetti');
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          const width = window.innerWidth;
          const height = window.innerHeight;
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = width * ratio;
          canvas.height = height * ratio;
          ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

          const small = width < 750;
          const card = this.dialog.getBoundingClientRect();
          // Purple and cyan lead; gold is the subtle third
          const colors = ['#8825e4', '#8825e4', '#a45cf0', '#6360eb', '#00e5ff', '#00ffff', '#7df9ff', '#e8b931'];
          const particles = Array.from({ length: small ? 60 : 100 }, () => {
            const angle = Math.random() * Math.PI * 2;
            const speed = (small ? 7 : 14) * (0.6 + Math.random());
            return {
              x: card.left + card.width * (0.2 + Math.random() * 0.6),
              y: card.top + card.height * (0.3 + Math.random() * 0.4),
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - 4,
              size: (small ? 6 : 8) + Math.random() * 6,
              color: colors[Math.floor(Math.random() * colors.length)],
              round: Math.random() < 0.25,
              rotation: Math.random() * Math.PI * 2,
              spin: (Math.random() - 0.5) * 0.2,
              flip: Math.random() * Math.PI * 2,
              flipSpeed: 0.05 + Math.random() * 0.08,
            };
          });

          const duration = 4000;
          const start = performance.now();
          let last = start;
          const frame = (now) => {
            const step = Math.min((now - last) / 16.7, 3);
            const elapsed = now - start;
            last = now;
            ctx.clearRect(0, 0, width, height);
            ctx.globalAlpha = Math.max(0, Math.min(1, (duration - elapsed) / 1000));
            for (const p of particles) {
              // Air drag slows the burst, gravity pulls down to a gentle falling speed, and a sway makes it float
              p.vx *= Math.pow(0.96, step);
              p.vy = Math.min(p.vy * Math.pow(0.96, step) + 0.22 * step, 3.2);
              p.flip += p.flipSpeed * step;
              p.rotation += p.spin * step;
              p.x += (p.vx + Math.sin(p.flip) * 0.8) * step;
              p.y += p.vy * step;
              if (p.y > height + 20) continue;
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate(p.rotation);
              ctx.scale(1, Math.cos(p.flip));
              ctx.fillStyle = p.color;
              if (p.round) {
                ctx.beginPath();
                ctx.arc(0, 0, p.size / 2.6, 0, Math.PI * 2);
                ctx.fill();
              } else {
                ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
              }
              ctx.restore();
            }
            if (elapsed < duration) {
              this.confettiFrame = requestAnimationFrame(frame);
            } else {
              this.stopConfetti();
            }
          };
          this.stopConfetti();
          this.confettiFrame = requestAnimationFrame(frame);
        }

        stopConfetti() {
          cancelAnimationFrame(this.confettiFrame);
          const canvas = this.querySelector('.sale-popup__confetti');
          canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Sale popup",
  "tag": "div",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "11.11 SALE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Main text",
      "default": "Up to 50% OFF on stylish phone cases"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Second line",
      "default": "Plus EXTRA 5% OFF on online payments"
    },
    {
      "type": "text",
      "id": "small_text",
      "label": "Small text",
      "default": "Sale runs from 05/11 to 25/11."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Delay before it opens",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Sale popup"
    }
  ]
}
{% endschema %}
