{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  On the About page this section is the About story intro: the store logo over the page content, in the grey band
  the About story card continues (the About hero shows the page title). On the contact template the page banner
  shows the title, so the page content alone is the contact form's centred intro (nothing when empty).
  Other pages keep Dawn's title and content.
{%- endcomment -%}
{%- if page.handle == 'about' or page.handle == 'about-us' -%}
  <div
    class="about-story cs-section"
    style="--cs-bg: #f6f6f6; --cs-pad-top: 80px; --cs-pad-bottom: 0px; --cs-pad-top-mobile: 60px; --cs-pad-bottom-mobile: 0px;"
  >
    <div class="about-story__container">
      <div class="about-story__intro{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="about-story__logo">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 750px) 20rem, 14rem', loading: 'lazy', alt: shop.name
            }}
          {%- else -%}
            <span class="about-story__logo-text">{{ shop.name | escape }}</span>
          {%- endif -%}
        </div>
        {%- if page.content != blank -%}
          <div class="about-story__text rte">{{ page.content }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif template.suffix == 'contact' -%}
  {%- if page.content != blank -%}
    <div class="contact-intro rte section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  {%- endif -%}
{%- else -%}
<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
