{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .best-sellers__heading,
  #shopify-section-{{ section.id }} .bs-card__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #shopify-section-{{ section.id }} .best-sellers__heading {
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Related products as the store's product cards (bs-card, like Best Sellers). The page renders other products
  from this product's collection (else the whole store) straight away; Dawn's <product-recommendations> then
  loads Shopify's recommendations and swaps them in when there are any. An empty recommendations response
  leaves the first list in place.
{%- endcomment -%}
{%- liquid
  assign source = nil
  if recommendations.performed
    if recommendations.products_count > 0
      assign source = recommendations.products
    endif
  else
    for collection in product.collections
      if collection.handle != 'all' and collection.products_count > 1
        assign source = collection.products
        break
      endif
    endfor
    if source == nil
      # ponytail: outside paginate Liquid sees the first 50 products of a collection; enough for a related list
      assign source = collections.all.products
    endif
  endif

  capture cards
    assign count = 0
    for item in source
      if item.id == product.id
        continue
      endif
      if count >= section.settings.products_to_show
        break
      endif
      assign count = count | plus: 1
      echo '<li class="ymal__item'
      if settings.animations_reveal_on_scroll
        echo ' scroll-trigger cs-reveal'
      endif
      echo '" style="--animation-order: ' | append: count | append: ';">'
      render 'bs-card', product: item, index: count, show_swatches: section.settings.show_swatches, action: 'cart'
      echo '</li>'
    endfor
  endcapture
-%}
<product-recommendations
  class="ymal"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&intent=related"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  {%- if cards != blank -%}
    <div
      class="cs-section"
      style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px; --bs-card-bg: {{ section.settings.card_background }}; --bs-badge: {{ section.settings.badge_color }}; --bs-accent: {{ section.settings.accent_color }};"
    >
      <div class="cs-container">
        {%- if section.settings.title != blank -%}
          <h2 class="best-sellers__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}">
            {{- section.settings.title | escape -}}
          </h2>
        {%- endif -%}
        <ul class="ymal__grid" role="list">{{ cards }}</ul>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "section section-you-may-also-like",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows Shopify's product recommendations for the product being viewed (manage them with the Search & Discovery app). Until there are any, it shows other products from the product's collection, or from the whole store."
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true, "info": "Uses the product option named Color or Colour" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading and product title font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F6F6F6" },
    { "type": "color", "id": "badge_color", "label": "Sale badge color", "default": "#DA1E28" },
    { "type": "color", "id": "accent_color", "label": "Buttons color", "default": "#0F61FF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 44 }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
