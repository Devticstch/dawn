{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .contact-thanks__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'templates.contact.form.post_success' | t
  endif
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'general.continue_shopping' | t
  endif
-%}

{%- comment -%}
  The contact form's thank-you page (page.thanks template, opened with ?view=thanks after a successful message):
  the message centred in the contact form's column and a button back to the homepage
{%- endcomment -%}
<div class="contact-thanks section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <h2 class="contact-thanks__title">{{ heading | escape }}</h2>
  {%- if section.settings.text != blank -%}
    <div class="contact-thanks__text rte">{{ section.settings.text }}</div>
  {%- endif -%}
  <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button contact-thanks__button">
    {{- button_label | escape -}}
  </a>
</div>

{% schema %}
{
  "name": "Contact thank-you",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank for the contact form's thank-you message" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave blank for \"Continue shopping\"" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank for the homepage" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 100 }
  ],
  "presets": [{ "name": "Contact thank-you" }]
}
{% endschema %}
