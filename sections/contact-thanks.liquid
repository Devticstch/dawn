{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .contact-thanks__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

{%- liquid
  assign image = section.settings.image
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'general.continue_shopping' | t
  endif
-%}

{%- comment -%}
  The contact form's thank-you page (page.thanks template, opened with ?view=thanks after a successful message; the
  layout leaves out the header and footer): a full-screen image under a dark overlay, the store logo, a confirmation
  mark, the message and a button back to the homepage
{%- endcomment -%}
<div class="contact-thanks">
  <div class="contact-thanks__media">
    {%- if image != blank -%}
      {%- assign image_sizes = image.aspect_ratio | times: 100 | round: 2 | prepend: 'max(100vw, ' | append: 'vh)' -%}
      {{
        image
        | image_url: width: 2400
        | image_tag:
          class: 'contact-thanks__image',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: image_sizes,
          fetchpriority: 'high',
          alt: ''
      }}
    {%- elsif section.settings.theme_image != blank -%}
      <img
        class="contact-thanks__image"
        src="{{ section.settings.theme_image | asset_url }}"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <a href="{{ routes.root_url }}" class="contact-thanks__logo">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 600
        | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 992px) 14rem, 9rem', alt: shop.name
      }}
    {%- else -%}
      {{ shop.name | escape }}
    {%- endif -%}
  </a>

  <div class="contact-thanks__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <span class="contact-thanks__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
    </span>
    {%- if section.settings.heading != blank -%}
      <h1 class="contact-thanks__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="contact-thanks__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button contact-thanks__button">
      {{- button_label | escape -}}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Contact thank-you",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Shown full screen under a dark overlay" },
    { "type": "text", "id": "theme_image", "label": "Theme image", "info": "File name from the theme assets, used when no image is selected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Thank You!" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Your message has been sent successfully. Our team will get back to you as soon as possible.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to Homepage", "info": "Leave blank for \"Continue shopping\"" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank for the homepage" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" }
  ],
  "presets": [{ "name": "Contact thank-you" }]
}
{% endschema %}
