{{ 'component-rating.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} :is(.prv__heading, .prv__score) {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

{%- liquid
  # Shopify's standard review metafields, filled by review apps
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign app_blocks = section.blocks | where: 'type', '@app'
-%}

{%- comment -%}
  Product reviews: the average rating from the review metafields beside the review app's own block
  (list, photos, write-a-review). Without either it shows the empty-state text.
{%- endcomment -%}
{%- if product -%}
  <div
    class="prv cs-section"
    style="--cs-bg: {{ section.settings.background }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
  >
    <div class="prv__container">
      <div class="prv__card{% if rating == blank or app_blocks.size == 0 %} prv__card--single{% endif %}">
        <div class="prv__summary">
          {%- if section.settings.heading != blank -%}
            <h2 class="prv__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if rating != blank -%}
            {%- liquid
              assign rating_decimal = 0
              assign decimal = rating.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                assign rating_decimal = 0.5
              elsif decimal > 0.7
                assign rating_decimal = 1
              endif
            -%}
            <div class="prv__average">
              <p class="prv__score" aria-hidden="true">{{ rating.rating | round: 1 }}</p>
              <div>
                <div
                  class="rating"
                  role="img"
                  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: rating.scale_max }}"
                >
                  <span
                    aria-hidden="true"
                    class="rating-star"
                    style="--rating: {{ rating.rating | floor }}; --rating-max: {{ rating.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                  ></span>
                </div>
                {%- if rating_count > 0 -%}
                  <p class="prv__count">{{ rating_count }} {{ 'accessibility.total_reviews' | t }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if app_blocks.size > 0 -%}
          <div class="prv__app">
            {%- for block in app_blocks -%}
              {% render block %}
            {%- endfor -%}
          </div>
        {%- elsif rating == blank -%}
          {%- if section.settings.empty_text != blank -%}
            <p class="prv__empty">{{ section.settings.empty_text | escape }}</p>
          {%- endif -%}
          {%- if request.design_mode -%}
            <p class="prv__hint">
              Theme editor only: install a product reviews app, then add its reviews block to this section. Ratings
              show here once the app has reviews.
            </p>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section section-product-reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's average rating from your reviews app and the app's own reviews block. Without reviews or an app block it shows the empty-state text."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "empty_text", "label": "Text when there are no reviews", "default": "No reviews yet." },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F6F6F6" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
