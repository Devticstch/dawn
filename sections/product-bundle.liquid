{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .pb__heading,
  #shopify-section-{{ section.id }} .pb__title,
  #shopify-section-{{ section.id }} .bs-card__title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
  }

  #shopify-section-{{ section.id }} .pb__heading,
  #shopify-section-{{ section.id }} .pb__title {
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<div
  class="pb cs-section"
  style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom }}px; --bs-card-bg: {{ section.settings.card_background }}; --bs-badge: {{ section.settings.badge_color }}; --bs-accent: {{ section.settings.accent_color }};"
>
  <div class="cs-container">
    {%- if section.settings.title != blank -%}
      <h2 class="pb__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <product-bundle
      class="pb__layout"
      data-money-format="{{ shop.money_format | escape }}"
      data-cart-add-url="{{ routes.cart_add_url }}.js"
      data-cart-url="{{ routes.cart_url }}"
      data-error="{{ 'sections.cart.cart_error' | t | escape }}"
    >
      <ul class="pb__grid" role="list">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li class="{% if settings.animations_reveal_on_scroll %}scroll-trigger cs-reveal{% endif %}" data-cascade>
            {%- render 'bs-card', product: product, index: forloop.index0, show_swatches: section.settings.show_swatches, action: 'bundle', action_label: section.settings.add_label -%}
          </li>
        {%- endfor -%}
      </ul>

      <aside class="pb__box" aria-label="{{ section.settings.box_title | escape }}">
        <div class="pb__head">
          <div class="pb__head-text">
            <p class="pb__title">{{ section.settings.box_title | escape }}</p>
            {%- if section.settings.box_subtitle != blank -%}
              <p class="pb__subtitle">{{ section.settings.box_subtitle | escape }}</p>
            {%- endif -%}
          </div>
          <button type="button" class="pb__toggle" data-bundle-toggle aria-expanded="false" aria-label="{{ section.settings.box_title | escape }}">
            <span class="svg-wrapper">{{- 'icon-cart-empty.svg' | inline_asset_content -}}</span>
            <span class="pb__count" data-bundle-count>0</span>
          </button>
        </div>

        <div class="pb__body">
          <div class="pb__empty" data-bundle-empty>
            <span class="pb__empty-icon" aria-hidden="true">
              <svg viewBox="0 0 108 104" fill="none">
                <path d="M34 38V30a20 20 0 0 1 40 0v8" stroke="currentColor" stroke-opacity=".45" stroke-width="5" stroke-linecap="round"/>
                <path d="M16 38h76l-6 58a6 6 0 0 1-6 5H28a6 6 0 0 1-6-5l-6-58Z" fill="currentColor" fill-opacity=".55"/>
                <path d="M54 38h38l-6 58a6 6 0 0 1-6 5H54V38Z" fill="currentColor" fill-opacity=".8"/>
              </svg>
              <span class="pb__empty-count" data-bundle-count>0</span>
            </span>
            {%- if section.settings.empty_text != blank -%}
              <p class="pb__empty-text">{{ section.settings.empty_text | escape }}</p>
            {%- endif -%}
          </div>

          <ul class="pb__items" role="list" data-bundle-list hidden></ul>

          <div class="pb__footer" data-bundle-footer hidden>
            <p class="pb__total">
              <span>{{ 'sections.cart.estimated_total' | t }}</span>
              <span data-bundle-total></span>
            </p>
            <button type="button" class="pb__button" data-bundle-submit>
              {%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
            </button>
            <p class="pb__error" role="alert" data-bundle-error hidden></p>
          </div>
        </div>

        <template data-bundle-row>
          <li class="pb__item">
            <img class="pb__item-image" alt="" width="48" height="48" loading="lazy">
            <span class="pb__item-info">
              <span class="pb__item-title"></span>
              <span class="pb__item-price"></span>
            </span>
            <button type="button" class="pb__item-remove" data-bundle-remove data-label="{{ 'sections.cart.remove_title' | t: title: '[title]' | escape }}">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m4 4 8 8M12 4l-8 8"/></svg>
            </button>
          </li>
        </template>
      </aside>
    </product-bundle>
  </div>
</div>

{% javascript %}
  // Shopping picks: collects products saved with the cards' "+" buttons and adds them all to the cart in one request.
  class ProductBundle extends HTMLElement {
    connectedCallback() {
      this.items = new Map();
      this.addEventListener('click', this.onClick.bind(this));
      // Mobile: the picks bar shows only while the section is on screen.
      this.observer = new IntersectionObserver(([entry]) => this.classList.toggle('is-in-view', entry.isIntersecting));
      this.observer.observe(this);
      this.render();
    }

    disconnectedCallback() {
      this.observer.disconnect();
    }

    onClick(event) {
      const add = event.target.closest('[data-bundle-add]');
      const remove = event.target.closest('[data-bundle-remove]');
      if (add) {
        const { variantId, title, price, image } = add.dataset;
        const item = this.items.get(variantId) || { title, price: Number(price), image, quantity: 0 };
        item.quantity += 1;
        this.items.set(variantId, item);
        this.render();
      } else if (remove) {
        this.items.delete(remove.dataset.variantId);
        this.render();
      } else if (event.target.closest('[data-bundle-toggle]')) {
        const open = !this.hasAttribute('open');
        this.toggleAttribute('open', open);
        this.querySelector('[data-bundle-toggle]').setAttribute('aria-expanded', open);
      } else if (event.target.closest('[data-bundle-submit]')) {
        this.submit(event.target.closest('[data-bundle-submit]'));
      }
    }

    // Shopify money formats: amount, amount_no_decimals and their comma-separator variants.
    format(cents) {
      const number = (decimals, thousands, separator) => {
        const [whole, fraction] = (cents / 100).toFixed(decimals).split('.');
        return whole.replace(/\B(?=(\d{3})+(?!\d))/g, thousands) + (fraction ? separator + fraction : '');
      };
      const formats = {
        amount: number(2, ',', '.'),
        amount_no_decimals: number(0, ',', '.'),
        amount_with_comma_separator: number(2, '.', ','),
        amount_no_decimals_with_comma_separator: number(0, '.', ','),
      };
      return this.dataset.moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, (_, key) => formats[key] || formats.amount);
    }

    render() {
      const count = [...this.items.values()].reduce((sum, item) => sum + item.quantity, 0);
      const total = [...this.items.values()].reduce((sum, item) => sum + item.price * item.quantity, 0);
      this.querySelectorAll('[data-bundle-count]').forEach((el) => (el.textContent = count));

      const list = this.querySelector('[data-bundle-list]');
      const template = this.querySelector('[data-bundle-row]');
      list.replaceChildren(...[...this.items].map(([id, item]) => {
        const row = template.content.firstElementChild.cloneNode(true);
        const image = row.querySelector('img');
        if (item.image) image.src = item.image; else image.remove();
        row.querySelector('.pb__item-title').textContent = item.quantity > 1 ? `${item.title} × ${item.quantity}` : item.title;
        row.querySelector('.pb__item-price').textContent = this.format(item.price * item.quantity);
        const remove = row.querySelector('[data-bundle-remove]');
        remove.dataset.variantId = id;
        remove.setAttribute('aria-label', remove.dataset.label.replace('[title]', item.title));
        return row;
      }));

      this.querySelector('[data-bundle-total]').textContent = this.format(total);
      list.hidden = count === 0;
      this.querySelector('[data-bundle-footer]').hidden = count === 0;
      this.querySelector('[data-bundle-empty]').hidden = count > 0;
    }

    async submit(button) {
      const error = this.querySelector('[data-bundle-error]');
      error.hidden = true;
      button.disabled = true;
      // With the cart drawer, ask for its sections in the same request and open it; otherwise go to the cart page
      const drawer = document.querySelector('cart-drawer');
      try {
        const response = await fetch(this.dataset.cartAddUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: [...this.items].map(([id, item]) => ({ id: Number(id), quantity: item.quantity })),
            ...(drawer && {
              sections: drawer.getSectionsToRender().map((section) => section.id),
              sections_url: window.location.pathname,
            }),
          }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.description || data.message || this.dataset.error);
        if (!drawer) {
          window.location.href = this.dataset.cartUrl;
          return;
        }
        drawer.classList.remove('is-empty');
        drawer.renderContents(data);
        button.disabled = false;
      } catch (e) {
        // Network failures (TypeError) get the store's cart error text; Shopify errors keep their own message.
        error.textContent = e instanceof TypeError ? this.dataset.error : e.message || this.dataset.error;
        error.hidden = false;
        button.disabled = false;
      }
    }
  }

  customElements.define('product-bundle', ProductBundle);
{% endjavascript %}

{% schema %}
{
  "name": "Shopping picks",
  "tag": "section",
  "class": "section section-product-bundle",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Pick Your Favourites" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true, "info": "Uses the product option named Color or Colour" },
    { "type": "header", "content": "Picks sidebar" },
    { "type": "text", "id": "box_title", "label": "Title", "default": "Your Shopping Picks" },
    { "type": "text", "id": "box_subtitle", "label": "Subtitle", "info": "Optional short line under the title. Only promise a discount that is set up in Shopify Admin > Discounts" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Tap + on any product to save it here, then add all your picks to the cart at once." },
    { "type": "text", "id": "add_label", "label": "\"+\" button label (screen readers)", "default": "Add to your picks" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add all to cart" },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "card_background", "label": "Card and box background", "default": "#F6F6F6" },
    { "type": "color", "id": "badge_color", "label": "Sale badge color", "default": "#DA1E28" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#8825E4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 50 }
  ],
  "presets": [{ "name": "Shopping picks" }]
}
{% endschema %}
