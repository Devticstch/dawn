{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .feature-showcase__heading,
  #shopify-section-{{ section.id }} .feature-showcase__overlay {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<div
  class="feature-showcase cs-section"
  style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px; --fs-panel-bg: {{ section.settings.panel_background }}; --fs-accent: {{ section.settings.accent_color }};"
>
  <div class="cs-container feature-showcase__grid">
    <div class="feature-showcase__card feature-showcase__card--tall{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}" data-cascade>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'feature-showcase__image cs-zoom-out',
            loading: 'lazy',
            widths: '400, 600, 900, 1200',
            sizes: '(min-width: 750px) 45vw, 92vw',
            alt: section.settings.image.alt
        }}
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="feature-showcase__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.overlay_small != blank or section.settings.overlay_large != blank -%}
        <p class="feature-showcase__overlay">
          {%- if section.settings.overlay_small != blank -%}
            <span class="feature-showcase__overlay-small">{{ section.settings.overlay_small | escape }}</span>
          {%- endif -%}
          {%- if section.settings.overlay_large != blank -%}
            <span class="feature-showcase__overlay-large">{{ section.settings.overlay_large | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    <div class="feature-showcase__side">
      <div class="feature-showcase__panel{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}" data-cascade>
        {%- if section.settings.heading != blank -%}
          <h2 class="feature-showcase__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="feature-showcase__features" role="list">
            {%- for block in section.blocks -%}
              <li class="feature-showcase__feature" {{ block.shopify_attributes }}>
                <span class="feature-showcase__icon">{% render 'cs-icon', icon: block.settings.icon %}</span>
                <span class="feature-showcase__label">
                  {{- block.settings.title | escape -}}
                  {%- if block.settings.subtitle != blank -%}
                    <br>{{ block.settings.subtitle | escape }}
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="feature-showcase__card feature-showcase__card--wide{% if settings.animations_reveal_on_scroll %} scroll-trigger cs-reveal{% endif %}" data-cascade>
        {%- if section.settings.secondary_image != blank -%}
          {{
            section.settings.secondary_image
            | image_url: width: 1200
            | image_tag:
              class: 'feature-showcase__image cs-zoom-out',
              loading: 'lazy',
              widths: '400, 600, 900, 1200',
              sizes: '(min-width: 750px) 45vw, 92vw',
              alt: section.settings.secondary_image.alt
          }}
        {%- elsif section.settings.secondary_theme_image != blank -%}
          <img
            class="feature-showcase__image cs-zoom-out"
            src="{{ section.settings.secondary_theme_image | asset_url }}"
            alt=""
            width="1400"
            height="629"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="feature-showcase__button">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature showcase",
  "tag": "section",
  "class": "section section-feature-showcase",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Image card" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SPECIAL FEATURES" },
    { "type": "text", "id": "overlay_small", "label": "Overlay text, small line", "default": "Super" },
    { "type": "text", "id": "overlay_large", "label": "Overlay text, large line", "default": "Slim" },
    { "type": "header", "content": "Feature panel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Protection, without the bulk" },
    { "type": "header", "content": "Second image card" },
    { "type": "image_picker", "id": "secondary_image", "label": "Image" },
    { "type": "text", "id": "secondary_theme_image", "label": "Theme image", "info": "File name from the theme assets, used when no image is selected" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop cases" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#F6F6F6" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#0F61FF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "warranty", "label": "Badge" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "secure", "label": "Secure" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "star", "label": "Star" }
          ],
          "default": "warranty"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "text", "id": "subtitle", "label": "Second line" }
      ]
    }
  ],
  "presets": [{ "name": "Feature showcase" }]
}
{% endschema %}
