<div
  class="category-cards cs-section"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --cc-card-bg: {{ section.settings.card_background }}; --cc-accent: {{ section.settings.accent_color }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.6 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.6 | round }}px;"
>
  <div class="cs-container category-cards__grid">
    {%- for block in section.blocks -%}
      <div
        class="category-cards__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade style="--animation-order: {{ forloop.index }};"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="category-cards__head">
          <h2 class="category-cards__heading">{{ block.settings.heading | escape }}</h2>
          {%- if block.settings.button_label != blank -%}
            <a
              {% if block.settings.button_link != blank %}
                href="{{ block.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="category-cards__button"
            >
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <div class="category-cards__hero">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 30vw, 70vw'
            }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <ul class="category-cards__links" role="list">
          {%- for i in (1..4) -%}
            {%- liquid
              assign collection_key = 'collection_' | append: i
              assign label_key = 'label_' | append: i
              assign collection = block.settings[collection_key]
              assign label = block.settings[label_key] | default: collection.title
            -%}
            {%- if collection != blank -%}
              <li>
                <a href="{{ collection.url }}" class="category-cards__link">
                  <span class="category-cards__thumb">
                    {%- if collection.featured_image != blank -%}
                      {{
                        collection.featured_image
                        | image_url: width: 160
                        | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '56px', alt: label
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </span>
                  <span class="category-cards__label">{{ label | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Category cards",
  "tag": "section",
  "class": "section section-category-cards",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F2F4F7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#2457F5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Phone Case"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Transparent PNG works best. Recommended 1000 × 900 px"
        },
        {
          "type": "header",
          "content": "Collection links"
        },
        { "type": "collection", "id": "collection_1", "label": "Collection 1" },
        { "type": "text", "id": "label_1", "label": "Label 1", "info": "Defaults to the collection title" },
        { "type": "collection", "id": "collection_2", "label": "Collection 2" },
        { "type": "text", "id": "label_2", "label": "Label 2" },
        { "type": "collection", "id": "collection_3", "label": "Collection 3" },
        { "type": "text", "id": "label_3", "label": "Label 3" },
        { "type": "collection", "id": "collection_4", "label": "Collection 4" },
        { "type": "text", "id": "label_4", "label": "Label 4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category cards",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "heading": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
