{{ 'section-hero-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-carousel.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #HeroCarousel-{{ section.id }} {
    --hero-height-mobile: {{ section.settings.height_mobile }}vw;
    --hero-height-desktop: {{ section.settings.height_desktop }}px;
  }
{%- endstyle -%}

<hero-carousel
  id="HeroCarousel-{{ section.id }}"
  class="hero-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_info | escape }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
>
  <div class="hero-carousel__viewport">
    <ul class="hero-carousel__track" id="HeroCarouselTrack-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign desktop_image = block.settings.image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign heading_tag = 'h2'
          if forloop.first
            assign heading_tag = 'h1'
          endif
        -%}
        <li
          class="hero-carousel__slide"
          id="HeroSlide-{{ section.id }}-{{ forloop.index }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ forloop.length }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="hero-carousel__link">
          {%- else -%}
            <div class="hero-carousel__link">
          {%- endif -%}

          <div class="hero-carousel__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  preload: 'metadata',
                  image_size: '1920x',
                  class: 'hero-carousel__video'
              }}
            {%- elsif desktop_image != blank -%}
              <picture>
                {%- if block.settings.mobile_image != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 375 }} 375w,
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1100 }} 1100w
                    "
                    sizes="100vw"
                  >
                {%- endif -%}
                {%- liquid
                  if forloop.first
                    assign loading = 'eager'
                    assign priority = 'high'
                  else
                    assign loading = 'lazy'
                    assign priority = 'auto'
                  endif
                -%}
                {{
                  desktop_image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                    sizes: '100vw',
                    loading: loading,
                    fetchpriority: priority,
                    class: 'hero-carousel__image'
                }}
              </picture>
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-carousel__image placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
            <div
              class="hero-carousel__caption"
              style="--tag-bg: {{ block.settings.tag_background }}; --tag-heading: {{ block.settings.heading_color }}; --tag-text: {{ block.settings.text_color }};"
            >
              {%- if block.settings.heading != blank -%}
                <{{ heading_tag }} class="hero-carousel__heading">{{ block.settings.heading | escape }}</{{ heading_tag }}>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div class="hero-carousel__subheading">{{ block.settings.subheading | escape | newline_to_br }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.blocks.size > 1 -%}
      <div class="hero-carousel__dots" role="group" aria-label="{{ 'sections.slideshow.carousel' | t | escape }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            aria-controls="HeroSlide-{{ section.id }}-{{ forloop.index }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
            data-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</hero-carousel>

{% schema %}
{
  "name": "Hero carousel",
  "tag": "section",
  "class": "section section-hero-carousel",
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Desktop height",
      "default": 580
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 60,
      "max": 180,
      "step": 5,
      "unit": "%",
      "label": "Mobile height (of screen width)",
      "default": 125
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Carousel description (for screen readers)",
      "default": "Featured collections"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Recommended 2880 × 1160 px"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Recommended 1100 × 1375 px"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted and looped in place of the image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "NEW! Collection"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Shop daily protection with drop-tested cases"
        },
        {
          "type": "color",
          "id": "tag_background",
          "label": "Label background",
          "default": "#F6E163"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#2C5DAB"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Subheading color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        {
          "type": "slide",
          "settings": {
            "heading": "Signature Cases",
            "subheading": "The award winning cases",
            "tag_background": "#FFFFFF",
            "heading_color": "#000000"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Unlimited Prints",
            "subheading": "Find your perfect case",
            "tag_background": "#C9E3FF",
            "heading_color": "#1A1A1A"
          }
        }
      ]
    }
  ]
}
{% endschema %}
