{%- liquid
  assign country_selector = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign country_selector = true
  endif
  assign language_selector = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign language_selector = true
  endif
  assign social_links = false
  if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
    assign social_links = true
  endif
  assign logo = section.settings.brand_image | default: settings.logo
-%}

{%- comment -%} Reference footer (DESIGN-SYSTEM.md 7.4): blue band, logo and intro, link columns, a large email field, bottom bar {%- endcomment -%}
<footer
  class="cs-footer"
  style="--cs-bg: {{ section.settings.background }}; --cs-text: {{ section.settings.text_color }}; --footer-cols: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="cs-footer__inner">
    <div class="cs-footer__top">
      <div class="cs-footer__brand">
        <a href="{{ routes.root_url }}" class="cs-footer__logo">
          {%- if logo != blank -%}
            {{
              logo
              | image_url: width: 340
              | image_tag: loading: 'lazy', widths: '170, 340', sizes: '170px', alt: shop.name, class: 'cs-footer__logo-image'
            }}
          {%- else -%}
            <span class="cs-footer__logo-text">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.brand_text != blank -%}
          <div class="cs-footer__intro">{{ section.settings.brand_text }}</div>
        {%- endif -%}
        {%- if section.settings.show_social and social_links -%}
          <div class="cs-footer__social">
            {%- if section.settings.social_heading != blank -%}
              <h2 class="cs-footer__heading">{{ section.settings.social_heading | escape }}</h2>
            {%- endif -%}
            {%- render 'social-icons' -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cs-footer__nav">
          {%- for block in section.blocks -%}
            {%- assign menu = block.settings.menu -%}
            <nav
              class="cs-footer__col"
              aria-label="{{ block.settings.heading | default: menu.title | escape }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading != blank -%}
                <h2 class="cs-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.links != blank -%}
                {%- comment -%} Typed links: "Title | URL" per line, resolved like the header menu (header-nav-url) {%- endcomment -%}
                {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
                <ul class="cs-footer__links" role="list">
                  {%- for line in lines -%}
                    {%- assign parts = line | split: '|' -%}
                    {%- assign link_title = parts.first | strip -%}
                    {%- if link_title == blank -%}{%- continue -%}{%- endif -%}
                    {%- assign link_url = parts[1] | strip -%}
                    {%- capture href -%}
                      {%- render 'header-nav-url', title: link_title, url: link_url -%}
                    {%- endcapture -%}
                    {%- if href == blank -%}{%- continue -%}{%- endif -%}
                    <li>
                      <a
                        href="{{ href }}"
                        class="cs-footer__link"
                        {% if href == request.path %}
                          aria-current="page"
                        {% endif %}
                        >{{ link_title | escape }}</a
                      >
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif menu != blank -%}
                <ul class="cs-footer__links" role="list">
                  {%- for link in menu.links -%}
                    {%- if link.links.size > 0 -%}
                      <li class="cs-footer__group-title">
                        <a href="{{ link.url }}" class="cs-footer__link">{{ link.title | escape }}</a>
                      </li>
                      {%- for child in link.links -%}
                        <li>
                          <a
                            href="{{ child.url }}"
                            class="cs-footer__link"
                            {% if child.current %}
                              aria-current="page"
                            {% endif %}
                            >{{ child.title | escape }}</a
                          >
                        </li>
                      {%- endfor -%}
                    {%- else -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="cs-footer__link"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                          >{{ link.title | escape }}</a
                        >
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.newsletter_enable -%}
      <div class="cs-footer__signup">
        {%- form 'customer', id: 'FooterBoldNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="cs-footer__message" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <div class="cs-footer__field">
              <label class="visually-hidden" for="FooterBoldEmail">
                {%- if section.settings.newsletter_heading != blank -%}
                  {{- section.settings.newsletter_heading | escape -}}
                {%- else -%}
                  {{- 'newsletter.label' | t -}}
                {%- endif -%}
              </label>
              <input
                id="FooterBoldEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="FooterBoldError"
                {% endif %}
              >
              <button type="submit" class="cs-footer__submit" aria-label="{{ section.settings.newsletter_button | escape }}">
                {%- for i in (1..2) -%}
                  <span class="cs-footer__submit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><path d="m10 7 5 5-5 5"/></svg></span>
                {%- endfor -%}
              </button>
            </div>
            {%- if form.errors -%}
              <p id="FooterBoldError" class="cs-footer__message" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
        {%- if section.settings.newsletter_legal != blank -%}
          <div class="cs-footer__legal">{{ section.settings.newsletter_legal }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cs-footer__bottom">
      <div class="cs-footer__bottom-left">
        <p class="cs-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} - {{ shop.name | link_to: routes.root_url, class: 'cs-footer__link' }} - {{ powered_by_link }}
        </p>
        {%- if shop.terms_of_service != blank -%}
          <ul class="cs-footer__policies" role="list">
            {%- if shop.terms_of_service != blank -%}
              <li><a href="{{ shop.terms_of_service.url }}" class="cs-footer__link">{{ shop.terms_of_service.title | escape }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="cs-footer__bottom-right">
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <div class="cs-footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="cs-footer__payment-list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if language_selector -%}
          <localization-form class="cs-footer__localization">
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <h2 class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
            {%- endform -%}
          </localization-form>
        {%- endif -%}
        {%- if country_selector -%}
          <localization-form class="cs-footer__localization">
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'FooterCountry' -%}
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% javascript %}
  // Footer reveal (custom-sections.css): pin the footer behind the page only while it fits between the bottom of
  // the header group (announcement bar and header, by their heights, so the sticky header's position doesn't count)
  // and the bottom of the window. Measured against the smallest viewport (clientHeight), so a phone's toolbar
  // showing or hiding never switches it on and off while scrolling
  (() => {
    const footer = document.querySelector('.section-footer-bold');
    if (!footer) return;
    const headerGroup = [...document.querySelectorAll('.shopify-section-group-header-group')];
    const update = () => {
      const headerHeight = headerGroup.reduce((sum, section) => sum + section.offsetHeight, 0);
      const space = document.documentElement.clientHeight - headerHeight;
      document.documentElement.classList.toggle('footer-reveal', footer.offsetHeight <= space);
    };
    const observer = new ResizeObserver(update);
    [footer, ...headerGroup].forEach((element) => observer.observe(element));
    window.addEventListener('resize', update);
    update();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Footer (bold)",
  "tag": "section",
  "class": "section section-footer-bold",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Logo",
      "info": "Shown in white. Uses the store logo when empty"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Intro text",
      "default": "<p>Protect your phone in style</p>"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Field label (for screen readers)",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Submit button label (for screen readers)",
      "default": "SIGN UP"
    },
    {
      "type": "richtext",
      "id": "newsletter_legal",
      "label": "Small print",
      "default": "<p>By continuing, you agree to our <a href=\"/policies/terms-of-service\" title=\"Terms of service\">Terms & Conditions</a> and <a href=\"/policies/privacy-policy\" title=\"Privacy policy\">Privacy Policy</a>.</p>"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true,
      "info": "Add your social links in Theme settings > Social media"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Let's be friends"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": true,
      "info": "Shown when the store has more than one language"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country/region selector",
      "default": true,
      "info": "Shown when the store sells to more than one country"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#1E1E1E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer",
          "info": "Nested menu items show as group titles"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "Used instead of the menu when filled. One per line, with a link after |, e.g. Shop | /collections/all. Without one: the collection named like the title, otherwise a product search. Links to missing pages are hidden."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer (bold)",
      "blocks": [
        { "type": "menu" },
        { "type": "menu", "settings": { "heading": "Device" } },
        { "type": "menu", "settings": { "heading": "About us" } },
        { "type": "menu", "settings": { "heading": "Get help" } }
      ]
    }
  ]
}
{% endschema %}
