{%- comment -%}
  About page story: the store logo over a centred intro, then a rounded card with an image beside a centred panel
  (icon, heading, text). Like the About hero it sits in the default page template and renders only on the About page.
  The logo and intro above the card are the Page section (main-page.liquid), which renders them on the About page.
{%- endcomment -%}
{%- if page.handle == 'about' or page.handle == 'about-us' -%}
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .about-story__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

<div
  class="about-story cs-section"
  style="--cs-bg: {{ section.settings.background }}; --about-story-panel: {{ section.settings.panel_background }}; --cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px;"
>
  <div class="about-story__container">
    <div class="about-story__card">
      <div class="about-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'about-story__image',
              widths: '375, 550, 750, 1100, 1600',
              sizes: '(min-width: 1920px) 796px, (min-width: 990px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'about-story__image about-story__placeholder' }}
        {%- endif -%}
      </div>
      <div class="about-story__panel">
        {%- if section.settings.icon != 'none' -%}
          <span class="about-story__icon">{% render 'cs-icon', icon: section.settings.icon %}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="about-story__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="about-story__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "About story",
  "tag": "section",
  "class": "section section-about-story",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows only on the About page (handle about or about-us). The logo and intro above it are the Page section (its text is the About page content in Shopify admin)."
    },
    { "type": "header", "content": "Card" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shows a Shopify placeholder until an image is chosen" },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shield", "label": "Shield" },
        { "value": "heart", "label": "Heart" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "trophy", "label": "Trophy" },
        { "value": "warranty", "label": "Warranty badge" },
        { "value": "star", "label": "Star" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "chat", "label": "Chat" },
        { "value": "gift", "label": "Gift" }
      ],
      "default": "shield"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen for everyday life" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our range brings together cases and accessories with two jobs in mind: helping protect your phone day to day, and suiting the way it looks. Browse the iPhone and Samsung collections to find the right one for your model.</p>"
    },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#F6F6F6" },
    { "type": "color", "id": "panel_background", "label": "Card text background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "About story" }]
}
{% endschema %}
