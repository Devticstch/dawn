{%- liquid
  assign image = section.settings.image
  assign show_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_button = true
  endif
-%}

<div
  class="image-button cs-section"
  style="--cs-pad-top: {{ section.settings.padding_top }}px; --cs-pad-bottom: {{ section.settings.padding_bottom }}px; --cs-pad-top-mobile: {{ section.settings.padding_top | times: 0.75 | round }}px; --cs-pad-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round }}px; --fs-accent: {{ section.settings.accent_color }};"
>
  <div class="image-button__media">
    {%- comment -%} Not lazy: Chrome never lazy-loads the fixed image inside the clip-path window; low priority keeps it behind the hero. It covers the viewport, so it is wider than the screen on tall screens (photo ratio times screen height) {%- endcomment -%}
    {%- if image != blank -%}
      {%- assign image_sizes = image.aspect_ratio | times: 100 | round: 2 | prepend: 'max(100vw, ' | append: 'vh)' -%}
      {{
        image
        | image_url: width: 2400
        | image_tag:
          class: 'image-button__image',
          loading: 'eager',
          fetchpriority: 'low',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: image_sizes,
          alt: image.alt
      }}
    {%- elsif section.settings.theme_image != blank -%}
      <img
        class="image-button__image"
        src="{{ section.settings.theme_image | asset_url }}"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="low"
      >
    {%- endif -%}
    {%- if section.settings.text != blank or show_button -%}
      <div class="image-button__content">
        {%- if section.settings.text != blank -%}
          <p class="image-button__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if show_button -%}
          <a href="{{ section.settings.button_link }}" class="feature-showcase__button">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image banner with button",
  "tag": "section",
  "class": "section section-image-banner-button",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Full width. Shown at 16:9 on desktop and 3:2 on mobile, cropped from the center" },
    { "type": "text", "id": "theme_image", "label": "Theme image", "info": "File name from the theme assets, used when no image is selected" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Short paragraph above the button"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#8825E4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Image banner with button" }]
}
{% endschema %}
