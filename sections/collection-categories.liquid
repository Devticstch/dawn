{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .ccat__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{%- endstyle -%}

{%- comment -%} Reference "Shop by Category": heading, short intro, grey category tiles with a small image {%- endcomment -%}
<div class="ccat">
  <div class="ccat__container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ccat__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ccat__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ccat__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="ccat__list" role="list">
        {%- for block in section.blocks -%}
          {%- capture url -%}
            {%- render 'header-nav-url', title: block.settings.label, url: block.settings.link -%}
          {%- endcapture -%}
          {%- assign url = url | strip -%}
          {%- if block.settings.label != blank and url != blank -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ url }}" class="ccat__item">
                <span class="ccat__image">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 192 | image_tag: loading: 'lazy', widths: '96, 192', sizes: '48px', alt: '' }}
                  {%- elsif block.settings.theme_image != blank -%}
                    <img src="{{ block.settings.theme_image | asset_url }}" alt="" width="400" height="400" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="ccat__label">{{ block.settings.label | escape }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection categories",
  "tag": "section",
  "class": "section section-collection-categories",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "instrument_sans_n6" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "theme_image", "label": "Theme image", "info": "File name from the theme assets, used when no image is selected" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to use the collection named like the label, or a product search for it" }
      ]
    }
  ],
  "presets": [{ "name": "Collection categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
